---
import logoDay from "../assets/superfile-day.svg";
import logoNight from "../assets/superfile-night.svg";
import SiteNav from "../components/SiteNav.astro";
import Landing from "../layouts/Landing.astro";
import "../styles/branding.css";

type Locale = "en" | "zh-tw";

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? "en";
const isZhTw = locale === "zh-tw";
const prefix = isZhTw ? "/zh-tw" : "";
const homeHref = isZhTw ? "/zh-tw/" : "/";

const copy = {
	en: {
		title: "Xelif branding",
		description: "Naming guidance for Xelif and attribution for visual assets inherited from superfile.",
		nav: {
			docs: "Docs",
			github: "Upstream",
			discord: "Discord",
			getStarted: "get started",
			homeAria: "Xelif home"
		},
		label: "// brand assets",
		headline: "Call the fork Xelif",
		intro: "Use Xelif for this working project. Use superfile when referring to yorukot's upstream project, compatibility names, inherited assets, or upstream packages and community.",
		nameRule: "Write the fork name as Xelif, with a capital X.",
		nameNote: "The executable remains spf and configuration directories remain named superfile for compatibility.",
		assetsTitle: "Inherited upstream assets",
		assets: [
			{
				title: "App icon",
				description: "The upstream superfile app icon. Do not present it as an original Xelif mark.",
				href: "/logo.svg",
				download: "superfile-logo.svg",
				preview: "/logo.svg",
				modifier: "brand-asset-preview--icon"
			},
			{
				title: "Wordmark for dark backgrounds",
				description: "The upstream superfile wordmark for dark layouts, retained with attribution.",
				href: logoNight.src,
				download: "superfile-wordmark-dark.svg",
				preview: logoNight.src,
				modifier: "brand-asset-preview--dark"
			},
			{
				title: "Wordmark for light backgrounds",
				description: "The upstream superfile wordmark for light layouts, retained with attribution.",
				href: logoDay.src,
				download: "superfile-wordmark-light.svg",
				preview: logoDay.src,
				modifier: "brand-asset-preview--light"
			}
		],
		download: "Download SVG",
		usageTitle: "Usage notes",
		usage: [
			"Use Xelif for the fork and superfile for the upstream project.",
			"Link upstream references to github.com/yorukot/superfile.",
			"Keep upstream logo proportions intact and identify the asset as inherited from superfile.",
			"Retain the MIT license and third-party notices when redistributing the project."
		],
		footer: {
			license: "MIT License",
			byPrefix: "based on work by",
			byConnector: " & ",
			contributorsText: "contributors",
			bySuffixEnd: "",
			docs: "Docs",
			branding: "Branding",
			github: "GitHub",
			discord: "Discord",
			changelog: "Changelog",
			install: "Install",
			contributors: "Contributors"
		}
	},
	"zh-tw": {
		title: "Xelif 品牌資源",
		description: "Xelif 名稱使用方式，以及繼承自 superfile 的視覺資產標示。",
		nav: {
			docs: "文件",
			github: "上游專案",
			discord: "Discord",
			getStarted: "開始使用",
			homeAria: "Xelif 首頁"
		},
		label: "// 品牌資源",
		headline: "此分支稱為 Xelif",
		intro: "此工作專案請使用 Xelif；提及 yorukot 的上游專案、相容名稱、繼承資產、套件或社群時則使用 superfile。",
		nameRule: "分支名稱請寫成 Xelif，X 使用大寫。",
		nameNote: "為了相容性，執行檔仍稱為 spf，設定目錄仍稱為 superfile。",
		assetsTitle: "繼承的上游資產",
		assets: [
			{
				title: "App 圖示",
				description: "獨立資料夾圖示，適合頭像、列表、徽章與小尺寸位置。",
				href: "/logo.svg",
				download: "superfile-logo.svg",
				preview: "/logo.svg",
				modifier: "brand-asset-preview--icon"
			},
			{
				title: "深色背景字標",
				description: "搭配淺色文字的完整 superfile 字標，適合深色版面。",
				href: logoNight.src,
				download: "superfile-wordmark-dark.svg",
				preview: logoNight.src,
				modifier: "brand-asset-preview--dark"
			},
			{
				title: "淺色背景字標",
				description: "搭配深色文字的完整 superfile 字標，適合淺色版面。",
				href: logoDay.src,
				download: "superfile-wordmark-light.svg",
				preview: logoDay.src,
				modifier: "brand-asset-preview--light"
			}
		],
		download: "下載 SVG",
		usageTitle: "使用提醒",
		usage: [
			"此分支使用 Xelif，上游專案使用 superfile。",
			"提及上游時請連結至 github.com/yorukot/superfile。",
			"請維持上游標誌比例，並清楚標示該資產繼承自 superfile。",
			"重新散布專案時請保留 MIT 授權及第三方聲明。"
		],
		footer: {
			license: "MIT 授權",
			byPrefix: "基於",
			byConnector: " 與",
			contributorsText: "貢獻者",
			bySuffixEnd: "共同維護",
			docs: "文件",
			branding: "品牌",
			github: "GitHub",
			discord: "Discord",
			changelog: "更新紀錄",
			install: "安裝",
			contributors: "貢獻者"
		}
	}
}[locale];
---

<Landing title={copy.title} description={copy.description} lang={isZhTw ? "zh-TW" : "en"} canonicalPath={`${prefix}/branding`}>
	<SiteNav isZhTw={isZhTw} baseSlug="branding" labels={copy.nav} />

	<main class="branding-page">
		<section class="branding-hero" aria-labelledby="branding-title">
			<div class="branding-hero-copy">
				<span class="branding-label">{copy.label}</span>
				<h1 id="branding-title">{copy.headline}</h1>
				<p>{copy.intro}</p>
			</div>

			<aside class="brand-name-card" aria-label={copy.nameRule}>
				<p class="brand-name-card-kicker">naming</p>
				<p class="brand-name-card-name">Xelif</p>
				<p class="brand-name-card-rule">{copy.nameRule}</p>
				<p class="brand-name-card-note">{copy.nameNote}</p>
			</aside>
		</section>

		<section class="brand-section" aria-labelledby="assets-title">
			<div class="brand-section-heading">
				<h2 id="assets-title">{copy.assetsTitle}</h2>
			</div>

			<div class="brand-assets-grid">
				{
					copy.assets.map(asset => (
						<article class="brand-asset-card">
							<div class={`brand-asset-preview ${asset.modifier}`}>
								<img src={asset.preview} alt={asset.title} loading="lazy" decoding="async" />
							</div>
							<div class="brand-asset-body">
								<h3>{asset.title}</h3>
								<p>{asset.description}</p>
								<a class="brand-download-link" href={asset.href} download={asset.download}>
									{copy.download}
								</a>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="brand-section brand-usage" aria-labelledby="usage-title">
			<div class="brand-section-heading">
				<h2 id="usage-title">{copy.usageTitle}</h2>
			</div>

			<ul>
				{copy.usage.map(item => <li>{item}</li>)}
			</ul>
		</section>
	</main>

	<footer class="branding-footer">
		<div class="branding-footer-inner">
			<div class="branding-footer-left">
				<a href={homeHref} class="branding-footer-brand">Xelif</a>
				<span class="branding-footer-sep" aria-hidden="true">·</span>
				<span>{copy.footer.license}</span>
				<span class="branding-footer-sep" aria-hidden="true">·</span>
				<span>
					{copy.footer.byPrefix}
					<a href="https://github.com/yorukot" class="branding-text-link" target="_blank" rel="noopener noreferrer">yorukot</a>{copy.footer.byConnector}<a
						href={`${prefix}/special-thanks`}
						class="branding-text-link"
					>
						{copy.footer.contributorsText}
					</a>{copy.footer.bySuffixEnd}
				</span>
			</div>
			<nav class="branding-footer-links" aria-label="Footer">
				<a href={`${prefix}/overview`}>{copy.footer.docs}</a>
				<a href={`${prefix}/branding`}>{copy.footer.branding}</a>
				<a href={`${prefix}/special-thanks`}>{copy.footer.contributors}</a>
				<a href="https://github.com/yorukot/superfile" target="_blank" rel="noopener noreferrer">{copy.footer.github}</a>
				<a href="https://discord.gg/YYtJ23Du7B" target="_blank" rel="noopener noreferrer">{copy.footer.discord}</a>
				<a href={`${prefix}/changelog`}>{copy.footer.changelog}</a>
				<a href={`${prefix}/getting-started/installation`}>{copy.footer.install}</a>
			</nav>
		</div>
	</footer>
</Landing>
